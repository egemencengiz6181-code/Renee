# Copy this file to .env.local for local development
# Add these values to Vercel dashboard → Project Settings → Environment Variables

# ─── Formların düşeceği adres ────────────────────────────────────────────────
# Tanımlanmazsa alim.demirli@abdkurumlari.com kullanılır.
CONTACT_TO_EMAIL="alim.demirli@abdkurumlari.com"

# ─── Gönderim yolu: A ya da B'den BİRİNİ doldur ──────────────────────────────

# A) Resend (önerilen). RESEND_API_KEY doluysa SMTP hiç kullanılmaz,
#    Office365'in SMTP politikasına bağımlılık ortadan kalkar.
#    RESEND_FROM, Resend'de doğrulanmış bir alan adına ait olmalı.
RESEND_API_KEY=""
RESEND_FROM="formlar@abdkurumlari.com"

# B) SMTP (RESEND_API_KEY boşsa bu kullanılır).
#    Office365 / Outlook: 587 + STARTTLS. 465 girilirse kod otomatik olarak
#    baştan-TLS moduna geçer.
#    NOT: Office365'te "Kimliği doğrulanmış SMTP" kiracı/kutu düzeyinde
#    açık olmalı, aksi halde 535 5.7.139 hatası alınır.
SMTP_HOST="smtp.office365.com"
SMTP_PORT="587"
SMTP_USER="alim.demirli@abdkurumlari.com"
SMTP_PASS=""
